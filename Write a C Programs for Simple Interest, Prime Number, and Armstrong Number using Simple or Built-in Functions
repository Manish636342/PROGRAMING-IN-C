#include <stdio.h>
#include <stdbool.h>
#include <math.h>

// Function to calculate simple interest
void calculateSimpleInterest() {
    float principal, rate, time;

    printf("\n--- Simple Interest Calculator ---\n");

    printf("Enter Principal amount: ");
    scanf("%f", &principal);

    printf("Enter Rate of interest (in %%): ");
    scanf("%f", &rate);

    printf("Enter Time (in years): ");
    scanf("%f", &time);

    float interest = (principal * rate * time) / 100.0;
    printf("Simple Interest = %.2f\n\n", interest);
}

// Function to check if a number is prime
bool isPrime(int num) {
    if (num <= 1) return false;

    for (int i = 2; i * i <= num; i++) {
        if (num % i == 0)
            return false;
    }
    return true;
}

void checkPrime() {
    int number;

    printf("\n--- Prime Number Checker ---\n");

    printf("Enter a number: ");
    scanf("%d", &number);

    if (isPrime(number))
        printf("%d is a Prime Number.\n\n", number);
    else
        printf("%d is NOT a Prime Number.\n\n", number);
}

// Function to check Armstrong number
void checkArmstrong() {
    int num, original, remainder, digits = 0;
    float result = 0.0;

    printf("\n--- Armstrong Number Checker ---\n");

    printf("Enter a number: ");
    scanf("%d", &num);

    original = num;

    // Count digits
    for (int temp = num; temp != 0; temp /= 10)
        digits++;

    // Calculate Armstrong sum
    for (int temp = num; temp != 0; temp /= 10) {
        remainder = temp % 10;
        result += pow(remainder, digits);
    }

    if ((int)result == original)
        printf("%d IS an Armstrong Number.\n\n", original);
    else
        printf("%d is NOT an Armstrong Number.\n\n", original);
}

int main() {
    int choice;

    while (1) {
        printf("========= MENU =========\n");
        printf("1. Calculate Simple Interest\n");
        printf("2. Check Prime Number\n");
        printf("3. Check Armstrong Number\n");
        printf("4. Exit\n");
        printf("========================\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1: calculateSimpleInterest(); break;
            case 2: checkPrime(); break;
            case 3: checkArmstrong(); break;
            case 4: 
                printf("Exiting program... Goodbye!\n");
                return 0;
            default:
                printf("Invalid choice! Please try again.\n\n");
        }
    }
}
